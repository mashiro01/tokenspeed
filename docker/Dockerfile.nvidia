# Build with buildx for linux/amd64 and linux/arm64. The base image is a
# multi-architecture manifest; prefer a native arm64 builder because QEMU
# emulation can make native extension builds substantially slower.
FROM lightseekorg/tokenspeed-runner:cu130-torch-2.11.0-flashinfer-0.6.15.post1

USER root

ARG MAX_JOBS=16
ARG CUDA_ARCH_LIST="9.0a 10.0a 12.0a"
ARG CUDA_HOME=/usr/local/cuda-13.0
ARG FLASH_LINEAR_ATTENTION_VERSION=0.5.1
ARG FLASHINFER_JIT_CACHE_VERSION=0.6.16.post3+cu130

ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV CUDA_HOME=${CUDA_HOME}
ENV PATH=${CUDA_HOME}/bin:${PATH}

WORKDIR /workspace

# libnuma1 is required at runtime by torch_memory_saver, a TokenSpeed
# dependency. Install system dependencies before copying sources to preserve
# this cache layer across source-only changes.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl-dev \
        libopenmpi-dev \
        libnuma1 \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

# Keep heavyweight third-party dependencies in a source-independent layer so
# native-kernel iterations can reuse the download and build cache.
RUN test -x "${CUDA_HOME}/bin/nvcc" && \
    python3 -m pip install cmake ninja && \
    python3 -m pip install \
        "flashinfer-jit-cache==${FLASHINFER_JIT_CACHE_VERSION}" \
        --index-url https://flashinfer.ai/whl/cu130 && \
    TORCH_CUDA_ARCH_LIST="${CUDA_ARCH_LIST}" \
    python3 -m pip install \
        "flash-linear-attention==${FLASH_LINEAR_ATTENTION_VERSION}" \
        --no-build-isolation

COPY . /workspace

# Install every TokenSpeed package from this checkout so the image always
# contains the source being built, rather than published package wheels.
RUN \
    MAX_JOBS=${MAX_JOBS} \
    FLASHINFER_CUDA_ARCH_LIST="${CUDA_ARCH_LIST}" \
    TOKENSPEED_KERNEL_BACKEND=cuda \
    python3 -m pip install tokenspeed-kernel/python/ --no-build-isolation && \
    python3 -m pip install tokenspeed-scheduler/ && \
    python3 -m pip install ./python --no-build-isolation

CMD ["/bin/bash"]
